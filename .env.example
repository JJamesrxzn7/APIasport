# Use the PostgreSQL connection string from Supabase. URL-encode special
# characters in the password and require SSL for remote connections.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require

# JSON array of exact origins; GitHub Pages repository paths share this origin.
# Add localhost origins only when developing locally. Never use "*".
CORS_ORIGINS=["https://jjamesrxzn7.github.io","http://localhost:5500","http://127.0.0.1:5500","http://localhost:5501","http://127.0.0.1:5501","http://localhost:5502","http://127.0.0.1:5502"]
